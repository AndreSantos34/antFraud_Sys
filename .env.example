# ─── Google Gemini API ────────────────────────────────────────────────────────
# Obtenha em: https://aistudio.google.com → "Get API Key"
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Modelos por Agente (opcional — padrões já configurados) ──────────────────
# Agente 1 — Análise de Risco         (temperatura 0.1 — determinístico)
GEMINI_MODEL_AGENT1=gemini-1.5-flash
# Agente 2 — Investigação de Ameaças  (temperatura 0.4 — contextual)
GEMINI_MODEL_AGENT2=gemini-1.5-flash
# Agente 3 — Base de Dados            (temperatura 0.2 — estruturado)
GEMINI_MODEL_AGENT3=gemini-1.5-flash
# Agente 4 — IA Mestre                (temperatura 0.4 — síntese final)
GEMINI_MODEL_AGENT4=gemini-1.5-pro

# ─── API Settings ─────────────────────────────────────────────────────────────
APP_PORT=8000
APP_HOST=0.0.0.0
DEBUG=true

# ─── Segurança ────────────────────────────────────────────────────────────────
# Troque por uma chave forte em produção
API_SECRET_KEY=nuclea-dev-key-change-in-production

# ─── Monitor Background ───────────────────────────────────────────────────────
# Intervalo em segundos entre transações simuladas (mínimo recomendado: 1.0)
MONITOR_INTERVAL_SECONDS=2.0
# true = inicia o monitor automaticamente ao subir a API
MONITOR_AUTOSTART=true

# ─── Fraud Detection Thresholds ───────────────────────────────────────────────
HIGH_VALUE_THRESHOLD=5000.00
UNUSUAL_HOUR_START=22
UNUSUAL_HOUR_END=6
HIGH_FREQ_MAX_TX=3
HIGH_FREQ_WINDOW_MIN=10
