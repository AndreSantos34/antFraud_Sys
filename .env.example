# ─── IBM WatsonX Credentials ──────────────────────────────────────────────────
WATSONX_API_KEY=your_ibm_cloud_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# ─── MySQL Database ───────────────────────────────────────────────────────────
# Formato: mysql+pymysql://USUARIO:SENHA@HOST:PORTA/BANCO
#
# Preencha com as credenciais reais no arquivo .env (nunca neste arquivo).
# Deixe em branco ("") para desabilitar o MySQL e usar apenas arquivos JSON locais.
#
# Exemplos:
#   Usuário dedicado:  mysql+pymysql://antfraud_user:SENHA_FORTE@localhost:3306/antfraud_db
#   Root (dev local):  mysql+pymysql://root:SUA_SENHA@localhost:3306/antfraud_db
#
# IMPORTANTE:
#   - Nunca coloque a senha real neste arquivo (.env.example é versionado).
#   - O arquivo .env (com a senha real) está no .gitignore e NÃO deve ser commitado.
#   - Sem DATABASE_URL, a aplicação funciona em modo JSON-only e exibirá um aviso
#     no log: "[DB] DATABASE_URL não configurada — MySQL desabilitado."
DATABASE_URL=

# ─── API Settings ─────────────────────────────────────────────────────────────
APP_PORT=8000
APP_HOST=0.0.0.0
DEBUG=true

# ─── Segurança ────────────────────────────────────────────────────────────────
# Troque por uma chave forte em produção
API_SECRET_KEY=nuclea-dev-key-change-in-production

# ─── Monitor Background ────────────────────────────────────────────────────────
# Intervalo em segundos entre transações simuladas (mínimo recomendado: 1.0)
MONITOR_INTERVAL_SECONDS=2.0
# true = inicia o monitor automaticamente ao subir a API
MONITOR_AUTOSTART=true

# ─── Fraud Detection Thresholds ───────────────────────────────────────────────
# Valor mínimo (BRL) para triagem por valor elevado
HIGH_VALUE_THRESHOLD=5000.00
# Hora início do período noturno incomum (0-23)
UNUSUAL_HOUR_START=22
# Hora fim do período noturno incomum (0-23)
UNUSUAL_HOUR_END=6
# Número máximo de transações permitidas em curto intervalo (minutos)
HIGH_FREQ_MAX_TX=3
HIGH_FREQ_WINDOW_MIN=10
